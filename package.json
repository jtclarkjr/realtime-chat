{
  "name": "realtime-chat-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev",
    "dev:instance1": "bun run --bun next dev -p 3000",
    "dev:instance2": "bun run --bun next dev -p 3001",
    "build": "bun run --bun next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "oxlint && tsc --noEmit",
    "fmt": "oxfmt --write .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f redis",
    "docker:debug": "docker compose --profile debug up -d",
    "dev:docker": "docker compose up -d && bun dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook-local": "storybook build && rm -rf public/storybook && mv storybook-static public/storybook",
    "supabase:ssr:build": "tsc -p tsconfig.supabase-ssr.module.json && tsc -p tsconfig.supabase-ssr.main.json",
    "postinstall": "bun run supabase:ssr:build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@anthropic-ai/sdk": "^0.80.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "github:jtclarkjr/ssr",
    "@supabase/supabase-js": "^2.100.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@tavily/ai-sdk": "^0.4.1",
    "@tiptap/extension-code-block-lowlight": "^3.20.5",
    "@tiptap/extension-link": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "@types/ioredis": "^5.0.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.138",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.3",
    "flags": "^4.0.5",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "ky": "^1.14.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.6.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.5",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.42.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "supabase": "^2.84.0",
    "swagger-ui-react": "^5.32.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "qs": "^6.14.2",
    "tar": "^7.5.8",
    "dompurify": "^3.2.7",
    "ajv": "^6.14.0",
    "h3": "^1.15.10",
    "markdown-it": "^14.1.1",
    "minimatch": "^3.1.3",
    "serialize-javascript": "^7.0.3",
    "immutable": "^3.8.3",
    "bn.js": "^5.2.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "oxlint": "^1.57.0",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/nextjs-vite": "^10.3.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  }
