{
  "name": "realtime-chat-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev",
    "dev:instance1": "bun run --bun next dev -p 3000",
    "dev:instance2": "bun run --bun next dev -p 3001",
    "build": "bun run --bun next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "oxlint && tsc --noEmit",
    "fmt": "oxfmt --write .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f redis",
    "docker:debug": "docker compose --profile debug up -d",
    "dev:docker": "docker compose up -d && bun dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook-local": "storybook build && rm -rf public/storybook && mv storybook-static public/storybook",
    "supabase:ssr:build": "tsc -p tsconfig.supabase-ssr.module.json && tsc -p tsconfig.supabase-ssr.main.json",
    "postinstall": "bun run supabase:ssr:build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@anthropic-ai/sdk": "^0.78.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "github:jtclarkjr/ssr",
    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.21",
    "@tavily/ai-sdk": "^0.4.1",
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/ioredis": "^5.0.0",
    "@upstash/redis": "^1.36.4",
    "@vercel/analytics": "^2.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.3",
    "flags": "^4.0.4",
    "framer-motion": "^12.35.2",
    "ioredis": "^5.10.0",
    "ky": "^1.14.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.4",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.39.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "supabase": "^2.78.1",
    "swagger-ui-react": "^5.32.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "qs": "^6.14.2",
    "tar": "^7.5.8",
    "dompurify": "^3.2.7",
    "ajv": "^6.14.0",
    "markdown-it": "^14.1.1",
    "minimatch": "^3.1.3",
    "serialize-javascript": "^7.0.3",
    "immutable": "^3.8.3",
    "bn.js": "^5.2.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "oxlint": "^1.54.0",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-onboarding": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/nextjs": "^10.2.17",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "storybook": "^10.2.17",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
